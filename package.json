{
  "name": "sdet-interview-trainer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "prepare:pyodide": "node scripts/prepare-pyodide.mjs",
    "dev": "npm run prepare:pyodide && next dev",
    "build": "npm run prepare:pyodide && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:functional": "playwright test",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\" && node --conditions=react-server --import tsx --test tests/unit/coding-runner.test.ts",
    "audio:scripts": "node scripts/audio/generate-scripts.mjs",
    "audio:tts": "node scripts/audio/synthesize.mjs",
    "audio:captions": "node scripts/audio/captions.mjs",
    "audio:publish": "node scripts/audio/publish.mjs",
    "audio:build": "npm run audio:scripts && npm run audio:tts && npm run audio:captions",
    "audio:podcast:captions": "node scripts/audio/captions.mjs --podcast",
    "audio:podcast:publish": "node scripts/audio/publish.mjs --podcast",
    "audio:interview:captions": "node scripts/audio/captions.mjs --interview",
    "audio:interview:publish": "node scripts/audio/publish.mjs --interview"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "^3.0.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.6",
    "kokoro-js": "^1.2.1",
    "postcss": "^8.5.4",
    "pyodide": "^0.28.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
